# Server-only. Add real values to .env.local and your hosting environment.
RESEND_API_KEY=
# An address on a domain you have verified in Resend.
INQUIRY_FROM_EMAIL=
# Set to your canonical deployed origin, without a trailing slash.
# Leave empty for local development.
INQUIRY_SITE_ORIGIN=
# Recipient is configured server-side as emiliomsierra@outlook.com.

# Lucky Bird: reuse integration-managed credentials; never put values in Git.
STRIPE_SECRET_KEY=
DATABASE_URL=
# Signing secret for /api/luckybird/webhook in the selected environment only.
STRIPE_WEBHOOK_SECRET=
# Explicitly set test or live per environment; there is no automatic switching.
LUCKY_MODE=
LUCKY_STRIPE_SCHEMA=stripe
LUCKY_SITE_ORIGIN=https://www.emiliosierra.com
# Independent strong secret (32+ characters) to hash spam-limit identifiers.
LUCKY_SPAM_SECRET=
# Existing sandbox IDs only. Live IDs are recorded in luckybird-product.mjs.
LUCKY_TEST_PRODUCT_ID=
LUCKY_TEST_PRICE_ID=
